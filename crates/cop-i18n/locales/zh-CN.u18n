message config.invalid_field = "配置文件 {path} 的字段 {field}：{reason, select, unknown_field {未知字段} must_be_table {必须是表} must_be_string {必须是字符串} must_be_nonempty_string {必须是非空字符串} must_be_string_array {必须是字符串数组} must_be_boolean {必须是布尔值} must_be_array_of_tables {必须是表数组} invalid_cfg_name {无效的 cfg 名称} unknown_rule_id {未知规则 ID} unknown_severity {未知级别 {value}} unknown_value {未知值 {value}} duplicate {重复值 {value}} invalid {值无效} other {值无效}}";
