locale zh-CN;

message rule.item_spacing = "相邻定义之间应有 {expected} 个空行，当前有 {actual} 个";
message rule.module_file_layout = "子模块入口文件不能使用 mod.rs 布局";
message rule.out_of_line_modules_at_scope_start = "外部模块声明必须位于 extern crate 声明之后、use 声明和其他 item 之前，并连续排列";
message rule.child_module_visibility = "非私有子模块 {module} 只能包含声明项，以及私有、公开或 pub(crate) 可见性的 use 导入";
message rule.child_module_line_count = "子模块文件 {file} 的有效代码行数为 {actual}，要求在 {minimum} 到 {maximum} 行之间";
message rule.no_parent_path_attribute = "`#[path]` 路径不能使用 `..` 访问父目录";
message rule.no_parent_glob_import = "子模块不得使用 super::* 导入父模块实现";
message rule.no_parent_private_path = "子模块路径依赖了祖先模块 {ancestor} 的私有项 {item}";
message rule.impl_cross_file = "impl 目标 {target} 定义在其他源文件，impl 必须与类型定义位于同一文件";
message rule.impl_external_trait_target = "trait impl 的目标 {root} 不属于允许的标准库类型";
message rule.impl_inherent_target = "固有 impl 的目标必须是在当前源文件定义的类型";
message rule.impl_target_unresolved = "无法解析 impl 目标 {target} 的类型归属";
message rule.private_fields_for_behavior_type = "存在 impl 的类型 {name} 必须将所有字段设为私有";
message rule.unnecessary_pub_crate = "crate 可见声明 {name} 可以改为私有";
message rule.child_public_free_function = "子模块中的独立函数必须保持私有";
message rule.no_lint_relaxation = "禁止通过 allow 属性放宽 lint 检查";
message rule.function_parameter_limit = "函数参数数量为 {actual}，最多允许 {maximum} 个";
message rule.closure_parameter_limit = "闭包参数数量为 {actual}，最多允许 {maximum} 个";
message rule.tuple_arity = "tuple 元素数量为 {actual}，最多允许 {maximum} 个";
message rule.declaration_before_use = "名称 {name} 在其声明之前被引用";
message rule.no_inline_qualified_path = "显式限定路径 {path} 应先导入所需名称再使用";
message rule.extern_crate_at_scope_start = "extern crate 声明必须位于模块作用域开头";
message rule.use_at_scope_start = "模块作用域中的 use 声明必须位于外部模块声明之后、其他 item 之前";
message rule.block_use_at_scope_start = "block 作用域中的 use 声明必须位于首个非 use 语句之前";
message rule.merge_import_prefix = "此导入与第 {line} 行的导入共享前缀 {prefix}，可合并为一条 use tree";
message rule.merge_block_import_prefix = "此 block 导入与第 {line} 行共享前缀 {prefix}，可合并为一条 use tree";
message rule.cfg_use_group_split = "cfg 条件组 {condition} 被其他导入组拆开";
message rule.cfg_use_group_spacing = "不同 cfg 导入组之间应恰好有一个空行，当前有 {empty_lines} 个";
message rule.cfg_inside_use_tree = "use tree 花括号内部不能嵌套 cfg 属性";
message analysis.cfg_dependency_unknown = "依赖 {dependency} 的 target 条件无法静态确定";
message analysis.include_dynamic_input = "include! 会在编译时引入源码，静态模块图无法确认其内容";
message analysis.macro_generated_module = "项级宏 {name} 未展开，可能生成模块声明";
message analysis.module_cycle = "模块 {name} 再次载入当前递归链中的源文件";
message analysis.path_module_missing = "#[path] 指定的模块文件不存在";
message analysis.module_layout_ambiguous = "模块 {name} 同时匹配 name.rs 和 name/mod.rs 布局";
message analysis.module_missing = "找不到模块 {name}；已检查 name.rs 和 name/mod.rs 布局";
message analysis.module_source_read_error = "读取 Rust 源文件失败 {path}";
message analysis.module_file_metadata_error = "检查模块文件失败 {path}";
message analysis.parser_coverage = "{issue}";
message analysis.malformed_cfg_attribute = "cfg/path 属性无法可靠解释，相关模块分析可能不完整";
message analysis.malformed_cfg_expression = "无法解析此处的 cfg! predicate";
message analysis.cfg_macro_identity_unknown = "无法确认此 cfg! 调用是内置宏；其输入按不透明内容处理";
message analysis.unknown_cfg = "无法静态确定 cfg 条件 {condition}";
