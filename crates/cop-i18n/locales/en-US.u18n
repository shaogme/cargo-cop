message analysis.include_dynamic_input = "include! brings source code in at compile time, so the static module graph cannot determine its contents";
message analysis.macro_generated_module = "The item macro {name} was not expanded and may generate a module declaration";
message analysis.module_cycle = "Module {name} loads a source file that is already active in the current recursion chain";
