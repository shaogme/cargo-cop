locale en-US;

message rule.item_spacing = "Adjacent definitions require {expected} blank lines; found {actual, plural, one {# blank line} other {# blank lines}}";
message rule.item_spacing_maximum = "Adjacent same-kind definitions allow at most {maximum} blank lines; found {actual, plural, one {# blank line} other {# blank lines}}";
message rule.module_file_layout = "Submodule entry files must not use the mod.rs layout";
message rule.out_of_line_modules_at_scope_start = "Out-of-line module declarations must follow extern crate declarations and stay before use declarations and other items";
message rule.child_module_visibility = "Non-private submodule {module} may contain only declarations and use items with private, public, or pub(crate) visibility";
message rule.child_module_line_count = "The effective line count of submodule file {file} is {actual}; it must be between {minimum} and {maximum}";
message rule.no_parent_path_attribute = "A #[path] attribute must not traverse to a parent directory";
message rule.no_parent_glob_import = "Child modules must not use super::* to import parent implementation details";
message rule.no_parent_private_path = "The child module path depends on private item {item} from ancestor module {ancestor}";
message rule.impl_cross_file = "The impl target {target} is defined in another source file; impl blocks must be in the same file as the type definition";
message rule.impl_external_trait_target = "The trait impl target root {root} is not an allowed standard library type";
message rule.impl_inherent_target = "An inherent impl target must be a type defined in the current source file";
message rule.impl_target_unresolved = "Could not resolve the type ownership of impl target {target}";
message rule.private_fields_for_behavior_type = "All fields of type {name} with an impl block must be private";
message rule.unnecessary_pub_crate = "The crate-visible declaration {name} can be private";
message rule.child_public_free_function = "Free functions in child modules must be private";
message rule.no_lint_relaxation = "Do not relax lint checks with an allow attribute";
message rule.function_parameter_limit = "This function has {actual} parameters; the maximum is {maximum}";
message rule.closure_parameter_limit = "This closure has {actual} parameters; the maximum is {maximum}";
message rule.tuple_arity = "This tuple has {actual} elements; the maximum is {maximum}";
message rule.declaration_before_use = "Name {name} is referenced before its declaration";
message rule.no_inline_qualified_path = "Explicitly qualified path {path} should use an imported name instead";
message rule.extern_crate_at_scope_start = "extern crate declarations must appear at the start of a module scope";
message rule.use_at_scope_start = "Module-scope use declarations must follow out-of-line modules and precede other items";
message rule.block_use_at_scope_start = "A use declaration in a block must appear before the first non-use statement";
message rule.merge_import_prefix = "This import shares the prefix {prefix} with the import on line {line}; merge them into one use tree";
message rule.merge_block_import_prefix = "This block import shares the prefix {prefix} with the import on line {line}; merge them into one use tree";
message rule.cfg_use_group_split = "The cfg import group {condition} is split by another import group";
message rule.cfg_use_group_spacing = "Different cfg import groups must have exactly one blank line between them; found {empty_lines, plural, one {# blank line} other {# blank lines}}";
message rule.cfg_inside_use_tree = "Do not nest cfg attributes inside braces of a use tree";
