locale en-US;

message rule.item_spacing = "Adjacent definitions require {expected} blank lines; found {actual, plural, one {# blank line} other {# blank lines}}";
message rule.module_file_layout = "Submodule entry files must not use the mod.rs layout";
message rule.out_of_line_modules_at_scope_start = "Out-of-line module declarations must follow extern crate declarations and stay before use declarations and other items";
