message cli.about = "Check whether Rust source code follows repository conventions";
message cli.help = "Usage: cargo-cop [OPTIONS]
Check whether Rust source code follows repository conventions.

Options:
  --manifest-path <PATH>    Path to Cargo.toml
  --workspace               Scan the entire workspace
  -p, --package <NAME>      Select packages to scan; may be repeated
  --target <TRIPLE>         Target triple to scan
  --features <LIST>         Enable comma-separated features
  --cfg <CFG>               Add a custom cfg flag or key/value; may be repeated
  --all-features            Enable all features
  --no-default-features     Disable default features
  --all-targets             Scan all targets
  --config <PATH>           Configuration file path
  --locale <TAG>            Output locale (zh-CN, en-US)
  --format <FORMAT>         Output format: human or json
  --list-rules              List the rule catalog without scanning a project
  --explain-rule <ID>       Explain one rule without scanning a project
  --disable-rule <ID>       Disable a rule; may be repeated
  --severity <ID=LEVEL>     Set rule severity; may be repeated
  -h, --help                Print help
  -V, --version             Print version";
message cli.parse_error = "{kind, select, unknown {Unknown command-line option or subcommand. Use --help to see available options.} missing {A required command-line option or value is missing. Use --help to see usage.} invalid {A command-line option has an invalid value or format. Use --help to see valid forms.} conflict {The supplied command-line options cannot be used together.} other {Invalid command-line arguments. Use --help to see usage.}}";
message cli.version = "cargo-cop {version}";
